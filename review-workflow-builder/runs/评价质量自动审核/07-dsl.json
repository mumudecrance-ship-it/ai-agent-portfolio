{
  "app": {"name": "评价质量自动审核"},
  "variables": [
    {"name": "product_id", "type": "string", "required": true, "example": "100086651001"},
    {"name": "review_text", "type": "string", "required": true,
     "example": "对比过三款，这台的优势是睡眠模式真的安静，28 分贝不虚标。缺点是滤芯更换提示偏灵敏，感觉还能用就提示换了。总体推荐给卧室使用的朋友。"},
    {"name": "image_urls", "type": "array", "required": false, "example": ["img/u7a.jpg"]},
    {"name": "user_level", "type": "string", "required": false, "example": "评价官"},
    {"name": "inject", "type": "string", "required": false, "example": ""}
  ],
  "graph": {
    "nodes": [
      {"id": "start", "type": "start", "title": "开始"},
      {"id": "detail", "type": "http_request", "title": "商品信息获取",
       "config": {"method": "POST", "url": "http://127.0.0.1:8787/mock/item-center/detail",
                  "body": {"product_id": "{{#inputs.product_id#}}"}}},
      {"id": "form", "type": "code", "title": "形式判断",
       "config": {"inputs": {"text": "{{#inputs.review_text#}}", "imgs": "{{#inputs.image_urls#}}"},
                  "code": "imgs = inputs[\"imgs\"] or []\noutputs = {\"has_img\": \"yes\" if len(imgs) > 0 else \"no\", \"gt60\": \"yes\" if len(inputs[\"text\"]) > 60 else \"no\"}"}},
      {"id": "br_img", "type": "if_else", "title": "是否带图",
       "config": {"conditions": [{"left": "{{#form.has_img#}}", "op": "==", "right": "yes"}]}},
      {"id": "same_img", "type": "http_request", "title": "同图识别",
       "config": {"method": "POST", "url": "http://127.0.0.1:8787/mock/svc/same-image",
                  "body": {"image_urls": "{{#inputs.image_urls#}}", "__inject__": "{{#inputs.inject#}}"}}},
      {"id": "ai_img", "type": "http_request", "title": "AI生图识别",
       "config": {"method": "POST", "url": "http://127.0.0.1:8787/mock/svc/ai-image",
                  "body": {"image_urls": "{{#inputs.image_urls#}}"}}},
      {"id": "irr_img", "type": "http_request", "title": "无关图识别",
       "config": {"method": "POST", "url": "http://127.0.0.1:8787/mock/svc/irrelevant-image",
                  "body": {"image_urls": "{{#inputs.image_urls#}}"}}},
      {"id": "br_len", "type": "if_else", "title": "字数分流",
       "config": {"conditions": [{"left": "{{#form.gt60#}}", "op": "==", "right": "yes"}]}},
      {"id": "judge_hi", "type": "llm", "title": "大于60字低质量判定",
       "config": {"prompt": "只做高质量候选(0)与疑似低质量(1)判定，输出JSON{verdict,reason,confidence}。\n【商品】{{#detail.body.product.title#}}\n【卖点】{{#detail.body.product.sellpoints#}}\n【评价】{{#inputs.review_text#}}"}},
      {"id": "judge_lo", "type": "llm", "title": "小于60字低质量判定",
       "config": {"prompt": "只做普通(0)与疑似低质量(1)判定，输出JSON{verdict,reason,confidence}。\n【商品】{{#detail.body.product.title#}}\n【评价】{{#inputs.review_text#}}"}},
      {"id": "agg_judge", "type": "variable_aggregator", "title": "初筛聚合",
       "config": {"strategy": "first_not_null",
                  "variables": ["{{#judge_hi.json#}}", "{{#judge_lo.json#}}"]}},
      {"id": "br_q", "type": "if_else", "title": "初筛是否疑低质量",
       "config": {"conditions": [{"left": "{{#agg_judge.output.verdict#}}", "op": "==", "right": "1"}]}},
      {"id": "rag_tpl", "type": "knowledge_retrieval", "title": "检索本商品历史高质量评价",
       "config": {"query": "{{#inputs.review_text#}}", "top_k": 20, "product_id": "{{#inputs.product_id#}}"}},
      {"id": "tpl_chk", "type": "llm", "title": "套模板校验",
       "config": {"prompt": "参照本商品历史高质量评价，判断是否套模板，输出JSON{is_template,template_text}。\n【参照】{{#rag_tpl.result#}}\n【评价】{{#inputs.review_text#}}"}},
      {"id": "precision", "type": "llm", "title": "商品价值描述精准度",
       "config": {"prompt": "判断评价是否准确描述该商品特点，输出JSON{accurate,matched_points}。\n【商品】{{#detail.body.product.title#}}\n【卖点】{{#detail.body.product.sellpoints#}}\n【评价】{{#inputs.review_text#}}"}},
      {"id": "after_use", "type": "llm", "title": "是否使用后评价",
       "config": {"prompt": "判断是否为使用后的评价，输出JSON{after_use,evidence}。\n【商品】{{#detail.body.product.title#}}\n【评价】{{#inputs.review_text#}}"}},
      {"id": "low_type", "type": "llm", "title": "低质量类型细分",
       "config": {"prompt": "对疑似低质量评价分类：广告引流/极端情绪/跑题/水字数/拼写混乱/客观差评，输出JSON{type,confidence}。\n【评价】{{#inputs.review_text#}}"}},
      {"id": "final", "type": "code", "title": "综合判断",
       "config": {"inputs": {"v": "{{#agg_judge.output#}}", "si": "{{#same_img.body#}}",
                             "ai": "{{#ai_img.body#}}", "ir": "{{#irr_img.body#}}",
                             "tpl": "{{#tpl_chk.json#}}", "pr": "{{#precision.json#}}",
                             "au": "{{#after_use.json#}}", "lt": "{{#low_type.json#}}",
                             "gt60": "{{#form.gt60#}}"},
                  "code": "v = inputs[\"v\"] or {}\nsi = inputs[\"si\"] or {}\nai = inputs[\"ai\"] or {}\nir = inputs[\"ir\"] or {}\ntpl = inputs[\"tpl\"] or {}\npr = inputs[\"pr\"] or {}\nau = inputs[\"au\"] or {}\nlt = inputs[\"lt\"] or {}\ntext_low = v.get(\"verdict\") == 1\nimg_low = (si.get(\"result\") == 2) or (ai.get(\"result\") == 1) or (ir.get(\"result\") == 2)\nis_tpl = tpl.get(\"is_template\") == 1\nneed_human = (si.get(\"result\") == 1) or (ir.get(\"result\") == 1) or (float(v.get(\"confidence\") or 1) < 0.7)\nif text_low or img_low or is_tpl:\n    label = \"低质量\"\n    ltype = lt.get(\"type\") or (\"套模板\" if is_tpl else \"图片问题\")\n    if ltype == \"客观差评\":\n        label = \"普通\"\n        need_human = True\nelse:\n    good = (pr.get(\"accurate\") == 1) or (au.get(\"after_use\") == 1)\n    label = \"高质量\" if (good and inputs[\"gt60\"] == \"yes\") else \"普通\"\n    ltype = None\noutputs = {\"label\": label, \"low_type\": ltype, \"need_review\": need_human}"}},
      {"id": "end_ok", "type": "end", "title": "结束-输出质量标签",
       "config": {"outputs": {"label": "{{#final.label#}}", "low_type": "{{#final.low_type#}}",
                              "need_review": "{{#final.need_review#}}"}}}
    ],
    "edges": [
      {"source": "start", "target": "detail"},
      {"source": "start", "target": "form"},
      {"source": "form", "target": "br_img"},
      {"source": "form", "target": "br_len"},
      {"source": "br_img", "target": "same_img", "source_handle": "true"},
      {"source": "br_img", "target": "ai_img", "source_handle": "true"},
      {"source": "br_img", "target": "irr_img", "source_handle": "true"},
      {"source": "br_len", "target": "judge_hi", "source_handle": "true"},
      {"source": "br_len", "target": "judge_lo", "source_handle": "false"},
      {"source": "judge_hi", "target": "agg_judge"},
      {"source": "judge_lo", "target": "agg_judge"},
      {"source": "agg_judge", "target": "br_q"},
      {"source": "br_q", "target": "low_type", "source_handle": "true"},
      {"source": "br_q", "target": "rag_tpl", "source_handle": "false"},
      {"source": "br_q", "target": "precision", "source_handle": "false"},
      {"source": "br_q", "target": "after_use", "source_handle": "false"},
      {"source": "rag_tpl", "target": "tpl_chk"},
      {"source": "same_img", "target": "final"},
      {"source": "ai_img", "target": "final"},
      {"source": "irr_img", "target": "final"},
      {"source": "tpl_chk", "target": "final"},
      {"source": "precision", "target": "final"},
      {"source": "after_use", "target": "final"},
      {"source": "low_type", "target": "final"},
      {"source": "final", "target": "end_ok"}
    ]
  }
}
