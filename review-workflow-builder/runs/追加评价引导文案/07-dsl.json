{
  "app": {"name": "追加评价引导文案"},
  "variables": [
    {"name": "product_id", "type": "string", "required": true, "example": "100086651001"},
    {"name": "review_text", "type": "string", "required": true,
     "example": "开放式厨房做饭油烟味半小时就散了，晚上开睡眠档基本听不到声音，只有凑近才有轻微嗡嗡声。App 远程开机很方便。"},
    {"name": "star", "type": "number", "required": true, "example": 5},
    {"name": "has_followup", "type": "string", "required": true, "example": "no"},
    {"name": "inject", "type": "string", "required": false, "example": ""}
  ],
  "graph": {
    "nodes": [
      {"id": "start", "type": "start", "title": "开始"},
      {"id": "detail", "type": "http_request", "title": "商品信息获取",
       "config": {"method": "POST", "url": "http://127.0.0.1:8787/mock/item-center/detail",
                  "body": {"product_id": "{{#inputs.product_id#}}"}}},
      {"id": "filt", "type": "code", "title": "候选过滤",
       "config": {"inputs": {"text": "{{#inputs.review_text#}}", "star": "{{#inputs.star#}}",
                             "fu": "{{#inputs.has_followup#}}"},
                  "code": "star = float(inputs[\"star\"])\neligible = \"no\" if (inputs[\"fu\"] == \"yes\" or star <= 2) else \"yes\"\nlow_info = \"yes\" if len(inputs[\"text\"]) < 10 else \"no\"\noutputs = {\"eligible\": eligible, \"low_info\": low_info}"}},
      {"id": "br1", "type": "if_else", "title": "是否进引导",
       "config": {"conditions": [{"left": "{{#filt.eligible#}}", "op": "==", "right": "yes"}]}},
      {"id": "br2", "type": "if_else", "title": "是否个性化分支",
       "config": {"conditions": [{"left": "{{#filt.low_info#}}", "op": "==", "right": "no"}]}},
      {"id": "extract", "type": "llm", "title": "首评关键点提取",
       "config": {"prompt": "只判定并提取首评中最主要的可追问体验点，输出JSON{has_point,point,type,confidence}。\n【商品】{{#detail.body.product.title#}}\n【商品卖点】{{#detail.body.product.sellpoints#}}\n【首评】{{#inputs.review_text#}}"}},
      {"id": "br3", "type": "if_else", "title": "是否有有效关键点",
       "config": {"conditions": [{"left": "{{#extract.json.has_point#}}", "op": "==", "right": "1"}]}},
      {"id": "angle", "type": "code", "title": "追加评价角度映射",
       "config": {"inputs": {"t": "{{#extract.json.type#}}"},
                  "code": "m = {\"效果体验\": \"长期效果衰减\", \"耐用性\": \"耐用性\", \"适配场景\": \"适配场景\", \"操作清洁\": \"操作清洁\", \"噪音功耗\": \"长期使用噪音变化\"}\noutputs = {\"angle\": m.get(inputs[\"t\"], \"通用长期体验\")}"}},
      {"id": "gen", "type": "llm", "title": "追加评价引导文案生成",
       "config": {"prompt": "基于首评关键点生成中性追加评价引导文案，输出JSON{guide_text,angle,self_check}。\n【商品】{{#detail.body.product.title#}}\n【首评关键点】{{#extract.json.point#}}（类型：{{#extract.json.type#}}）\n【追加评价角度】{{#angle.angle#}}"}},
      {"id": "tpl_general", "type": "template_transform", "title": "通用引导文案",
       "config": {"template": "商品用了一段时间了，实际体验和刚收到时有变化吗？欢迎追加评价补充长期使用感受。"}},
      {"id": "agg", "type": "variable_aggregator", "title": "文案聚合",
       "config": {"strategy": "first_not_null",
                  "variables": ["{{#gen.json#}}", "{{#tpl_general.output#}}"]}},
      {"id": "norm", "type": "code", "title": "文案归一化",
       "config": {"inputs": {"v": "{{#agg.output#}}"},
                  "code": "v = inputs[\"v\"]\ngt = v[\"guide_text\"] if isinstance(v, dict) else v\nang = v.get(\"angle\", \"通用长期体验\") if isinstance(v, dict) else \"通用长期体验\"\noutputs = {\"guide_text\": gt, \"angle\": ang}"}},
      {"id": "sens", "type": "http_request", "title": "敏感词检测",
       "config": {"method": "POST", "url": "http://127.0.0.1:8787/mock/svc/sensitive-words",
                  "body": {"text": "{{#norm.guide_text#}}", "__inject__": "{{#inputs.inject#}}"}}},
      {"id": "br4", "type": "if_else", "title": "是否命中敏感词",
       "config": {"conditions": [{"left": "{{#sens.body.hit#}}", "op": "==", "right": "True"}]}},
      {"id": "pool", "type": "code", "title": "汇总审核池条目",
       "config": {"inputs": {"gt": "{{#norm.guide_text#}}", "ang": "{{#norm.angle#}}",
                             "rv": "{{#inputs.review_text#}}", "pid": "{{#inputs.product_id#}}"},
                  "code": "outputs = {\"entry\": {\"product_id\": inputs[\"pid\"], \"guide_text\": inputs[\"gt\"], \"angle\": inputs[\"ang\"], \"first_review_quote\": inputs[\"rv\"][:50]}}"}},
      {"id": "end_ok", "type": "end", "title": "结束-入运营审核池",
       "config": {"outputs": {"need_review": "true", "entry": "{{#pool.entry#}}"}}},
      {"id": "end_skip", "type": "end", "title": "结束-不打扰",
       "config": {"outputs": {"need_review": "false", "skip_reason": "已追加评价或差评未解决，不进引导"}}},
      {"id": "end_drop", "type": "end", "title": "结束-安全拦截",
       "config": {"outputs": {"need_review": "false", "drop_reason": "敏感词命中，文案丢弃并记录", "words": "{{#sens.body.words#}}"}}}
    ],
    "edges": [
      {"source": "start", "target": "filt"},
      {"source": "start", "target": "detail"},
      {"source": "filt", "target": "br1"},
      {"source": "br1", "target": "br2", "source_handle": "true"},
      {"source": "br1", "target": "end_skip", "source_handle": "false"},
      {"source": "br2", "target": "extract", "source_handle": "true"},
      {"source": "br2", "target": "tpl_general", "source_handle": "false"},
      {"source": "extract", "target": "br3"},
      {"source": "br3", "target": "angle", "source_handle": "true"},
      {"source": "br3", "target": "tpl_general", "source_handle": "false"},
      {"source": "angle", "target": "gen"},
      {"source": "gen", "target": "agg"},
      {"source": "tpl_general", "target": "agg"},
      {"source": "agg", "target": "norm"},
      {"source": "norm", "target": "sens"},
      {"source": "sens", "target": "br4"},
      {"source": "br4", "target": "pool", "source_handle": "false"},
      {"source": "br4", "target": "end_drop", "source_handle": "true"},
      {"source": "pool", "target": "end_ok"}
    ]
  }
}
