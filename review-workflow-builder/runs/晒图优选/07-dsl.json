{
  "app": {"name": "晒图优选"},
  "variables": [
    {"name": "product_id", "type": "string", "required": true, "example": "100086651001"},
    {"name": "review_text", "type": "string", "required": true,
     "example": "家里有猫，开一晚上第二天桌面浮毛明显少了。滤芯抽出来全是灰，说明确实在干活。噪音方面睡眠档可以接受，强力档偏响。"},
    {"name": "image_urls", "type": "array", "required": false, "example": ["img/u3a.jpg"]},
    {"name": "user_level", "type": "string", "required": true, "example": "PLUS会员"},
    {"name": "inject", "type": "string", "required": false, "example": ""}
  ],
  "graph": {
    "nodes": [
      {"id": "start", "type": "start", "title": "开始"},
      {"id": "detail", "type": "http_request", "title": "商品信息获取",
       "config": {"method": "POST", "url": "http://127.0.0.1:8787/mock/item-center/detail",
                  "body": {"product_id": "{{#inputs.product_id#}}"}}},
      {"id": "form", "type": "code", "title": "形式过滤",
       "config": {"inputs": {"imgs": "{{#inputs.image_urls#}}"},
                  "code": "imgs = inputs[\"imgs\"] or []\noutputs = {\"has_img\": \"yes\" if len(imgs) > 0 else \"no\"}"}},
      {"id": "br_img", "type": "if_else", "title": "是否带图",
       "config": {"conditions": [{"left": "{{#form.has_img#}}", "op": "==", "right": "yes"}]}},
      {"id": "same_img", "type": "http_request", "title": "同图识别",
       "config": {"method": "POST", "url": "http://127.0.0.1:8787/mock/svc/same-image",
                  "body": {"image_urls": "{{#inputs.image_urls#}}", "__inject__": "{{#inputs.inject#}}"}}},
      {"id": "ai_img", "type": "http_request", "title": "AI生图识别",
       "config": {"method": "POST", "url": "http://127.0.0.1:8787/mock/svc/ai-image",
                  "body": {"image_urls": "{{#inputs.image_urls#}}"}}},
      {"id": "irr_img", "type": "http_request", "title": "无关图识别",
       "config": {"method": "POST", "url": "http://127.0.0.1:8787/mock/svc/irrelevant-image",
                  "body": {"image_urls": "{{#inputs.image_urls#}}"}}},
      {"id": "judge", "type": "llm", "title": "证言价值判定",
       "config": {"prompt": "只判定评价文字是否具有真实使用证言价值，输出JSON{value,reason,confidence}。\n【商品】{{#detail.body.product.title#}}\n【卖点】{{#detail.body.product.sellpoints#}}\n【评价】{{#inputs.review_text#}}"}},
      {"id": "score", "type": "code", "title": "候选评分与组装",
       "config": {"inputs": {"si": "{{#same_img.body#}}", "ai": "{{#ai_img.body#}}",
                             "ir": "{{#irr_img.body#}}", "j": "{{#judge.json#}}",
                             "lv": "{{#inputs.user_level#}}", "rv": "{{#inputs.review_text#}}",
                             "imgs": "{{#inputs.image_urls#}}"},
                  "code": "si = inputs[\"si\"] or {}\nai = inputs[\"ai\"] or {}\nir = inputs[\"ir\"] or {}\nj = inputs[\"j\"] or {}\nimg_bad = (si.get(\"result\") in (1, 2)) or (ai.get(\"result\") == 1) or (ir.get(\"result\") in (1, 2))\neligible = (not img_bad) and (j.get(\"value\") == 1)\nbonus = {\"评价官\": 20, \"回头客\": 10}.get(inputs[\"lv\"], 0)\nscore = (60 + bonus + min(len(inputs[\"imgs\"] or []), 3) * 5) if eligible else 0\nreason = \"图片问题剔除\" if img_bad else (\"证言不足\" if j.get(\"value\") != 1 else j.get(\"reason\"))\noutputs = {\"eligible\": \"yes\" if eligible else \"no\", \"score\": score, \"reason\": reason}"}},
      {"id": "br_ok", "type": "if_else", "title": "是否入候选池",
       "config": {"conditions": [{"left": "{{#score.eligible#}}", "op": "==", "right": "yes"}]}},
      {"id": "pool", "type": "code", "title": "候选池条目输出",
       "config": {"inputs": {"pid": "{{#inputs.product_id#}}", "imgs": "{{#inputs.image_urls#}}",
                             "rv": "{{#inputs.review_text#}}", "s": "{{#score.score#}}",
                             "why": "{{#score.reason#}}"},
                  "code": "outputs = {\"entry\": {\"product_id\": inputs[\"pid\"], \"images\": inputs[\"imgs\"], \"score\": inputs[\"s\"], \"recommend_reason\": inputs[\"why\"], \"review_quote\": inputs[\"rv\"][:50]}}"}},
      {"id": "end_ok", "type": "end", "title": "结束-入运营审核池",
       "config": {"outputs": {"need_review": "true", "entry": "{{#pool.entry#}}"}}},
      {"id": "end_skip", "type": "end", "title": "结束-无图跳过",
       "config": {"outputs": {"need_review": "false", "skip_reason": "无图评价不进晒图链路"}}},
      {"id": "end_drop", "type": "end", "title": "结束-剔除",
       "config": {"outputs": {"need_review": "false", "drop_reason": "{{#score.reason#}}"}}}
    ],
    "edges": [
      {"source": "start", "target": "detail"},
      {"source": "start", "target": "form"},
      {"source": "form", "target": "br_img"},
      {"source": "br_img", "target": "same_img", "source_handle": "true"},
      {"source": "br_img", "target": "ai_img", "source_handle": "true"},
      {"source": "br_img", "target": "irr_img", "source_handle": "true"},
      {"source": "br_img", "target": "judge", "source_handle": "true"},
      {"source": "br_img", "target": "end_skip", "source_handle": "false"},
      {"source": "same_img", "target": "score"},
      {"source": "ai_img", "target": "score"},
      {"source": "irr_img", "target": "score"},
      {"source": "judge", "target": "score"},
      {"source": "score", "target": "br_ok"},
      {"source": "br_ok", "target": "pool", "source_handle": "true"},
      {"source": "br_ok", "target": "end_drop", "source_handle": "false"},
      {"source": "pool", "target": "end_ok"}
    ]
  }
}
